<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background_grouped"
    tools:context="com.violet.box.ui.main.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ios_background_elevated"
        android:elevation="8dp"
        android:translationZ="8dp"
        app:elevation="8dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ios_background_elevated"
            app:menu="@menu/toolbar_menu"
            app:popupTheme="@style/ThemeOverlay.Violet.ToolbarPopup"
            app:title="紫罗兰Box"
            app:titleTextAppearance="@style/Widget.Violet.ToolbarTitle"
            app:titleTextColor="@color/ios_text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_separator" />

    </com.google.android.material.appbar.AppBarLayout>

    <View
        android:id="@+id/overflowMenuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:background="#78000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="88dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ios_screen_edge"
            android:paddingTop="8dp"
            android:paddingBottom="28dp" />

    </androidx.core.widget.NestedScrollView>

    <!-- “设备”导航：使用 DeviceFragment 加载 fragment_device.xml -->
    <FrameLayout
        android:id="@+id/contentDevice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/device_fragment_container"
            android:name="com.violet.box.ui.device.DeviceFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <include
        android:id="@+id/fragmentExplorePlaceholder"
        layout="@layout/fragment_explore_placeholder"
        android:layout_marginTop="?attr/actionBarSize"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <include
        android:id="@+id/fragmentSettingsPlaceholder"
        layout="@layout/fragment_settings_placeholder"
        android:layout_marginTop="?attr/actionBarSize"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
    </include>

    <!-- Compose 底部悬浮导航被移到 MainActivity.java 中，用 AndroidView 渲染整个 activity_main -->
</androidx.coordinatorlayout.widget.CoordinatorLayout>
