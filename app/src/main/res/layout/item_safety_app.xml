<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_search_box"
    android:gravity="center_vertical"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/ivSafetyAppIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_icon_tile"
        android:padding="7dp"
        android:scaleType="fitCenter"
        tools:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSafetyAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ios_text_primary"
            android:textSize="15sp"
            tools:text="应用名称" />

        <TextView
            android:id="@+id/tvSafetyAppPkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ios_text_secondary"
            android:textSize="12sp"
            tools:text="com.example.app" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSafetyAppState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_status_tag"
        android:ellipsize="end"
        android:gravity="end"
        android:maxWidth="120dp"
        android:maxLines="2"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:textSize="11sp"
        tools:text="限制已下发" />

    <com.violet.box.ui.widget.KsuSwitchView
        android:id="@+id/swSafetyProtect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
